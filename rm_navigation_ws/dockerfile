ARG BASE_IMAGE=ros:humble-ros-base
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-c"]

# For Jetson native builds Docker will resolve the arm64 image variant.
# For cross-builds from x86, add: docker build --platform linux/arm64 ...
WORKDIR /ros_ws

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    clang \
    clang-format \
    clangd \
    cmake \
    git \
    libeigen3-dev \
    libpcl-dev \
    libssl-dev \
    libusb-1.0-0 \
    libusb-1.0-0-dev \
    psmisc \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-vcstool \
    python3-yaml \
    ros-humble-laser-geometry \
    ros-humble-nav2-bringup \
    ros-humble-navigation2 \
    ros-humble-pcl-conversions \
    ros-humble-pcl-ros \
    ros-humble-pointcloud-to-laserscan \
    ros-humble-rviz2 \
    ros-humble-tf2-tools \
    wget \
    && rm -rf /var/lib/apt/lists/*

RUN if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then rosdep init; fi \
    && rosdep update

WORKDIR /tmp
RUN git clone --depth=1 https://github.com/Livox-SDK/Livox-SDK2.git \
    && cmake -S Livox-SDK2 -B Livox-SDK2/build \
    && cmake --build Livox-SDK2/build -j"$(nproc)" \
    && cmake --install Livox-SDK2/build \
    && rm -rf Livox-SDK2

WORKDIR /ros_ws
RUN printf '%s\n' \
    'source /opt/ros/humble/setup.bash' \
    'if [ -f /ros_ws/install/setup.bash ]; then source /ros_ws/install/setup.bash; fi' \
    'export LD_LIBRARY_PATH=/usr/local/lib:${LD_LIBRARY_PATH}' \
    'git config --global --add safe.directory "*"' \
    >> /root/.bashrc

RUN sed --in-place --expression '$isource "/opt/ros/humble/setup.sh"' /ros_entrypoint.sh

ENV DEBIAN_FRONTEND=dialog
CMD ["/bin/bash"]
